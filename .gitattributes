# Enforce LF line endings for all text files
# Prevents CRLF issues across different OS (Windows vs Unix)
* text=auto eol=lf

# Robot Framework is whitespace-significant; never let a tool rewrite it.
*.robot text eol=lf

# Generated by `uv lock` — keep it out of diffs and language stats.
uv.lock linguist-generated=true
package-lock.json linguist-generated=true

# Explicitly set binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
