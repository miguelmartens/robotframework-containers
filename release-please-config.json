{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "robotframework-containers",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "build",
      "section": "Build and images"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ]
}
