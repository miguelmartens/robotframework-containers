# Robot Framework output
# reports/ is tracked as an empty directory so compose bind-mounts it with
# the right ownership instead of the engine creating it as root.
reports/*
!reports/.gitkeep
output.xml
log.html
report.html
*.png

# Tool caches
.robocop_cache/
.pabotsuitenames

# Node tooling (Prettier only)
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# Local build scratch
*.tar
.build/

# OS / editor
.DS_Store
.idea/
.vscode/
